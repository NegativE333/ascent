generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TopicStatus {
  not_started
  in_progress
  done
}

enum TopicPriority {
  high
  medium
  low
}

model Subject {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  topics       Topic[]

  @@map("subjects")
}

model Topic {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  subjectId       String        @map("subject_id") @db.Uuid
  name            String
  section         String?
  displayOrder    Int           @default(0) @map("display_order")
  status          TopicStatus   @default(not_started)
  priority        TopicPriority @default(medium)
  confidence      Int           @default(0)
  notes           String?
  estimatedMinutes Int          @default(0) @map("estimated_minutes")
  lastPracticedAt DateTime?     @map("last_practiced_at")
  lastRevisedAt   DateTime?     @map("last_revised_at")
  reviewCount     Int           @default(0) @map("review_count")
  statusUpdatedAt DateTime?     @map("status_updated_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  subject         Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sessions        McqSession[]
  studySessions   StudySession[]

  @@unique([userId, subjectId, name])
  @@index([userId])
  @@index([subjectId, section])
  @@map("topics")
}

model McqSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  topicId          String   @map("topic_id") @db.Uuid
  sessionDate      DateTime @map("session_date") @db.Date
  totalQuestions   Int      @map("total_questions")
  correctAnswers   Int      @map("correct_answers")
  timeTakenMinutes Int?     @map("time_taken_minutes")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  topic            Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([topicId])
  @@index([sessionDate])
  @@map("mcq_sessions")
}

/** Time spent studying a topic without necessarily answering questions. */
model StudySession {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  topicId     String   @map("topic_id") @db.Uuid
  sessionDate DateTime @map("session_date") @db.Date
  minutes     Int
  source      String   @default("timer")
  createdAt   DateTime @default(now()) @map("created_at")
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([topicId])
  @@index([sessionDate])
  @@map("study_sessions")
}

model UserSettings {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  examDate           DateTime? @map("exam_date") @db.Date
  weeklyTargetTopics Int       @default(3) @map("weekly_target_topics")
  weeklyTargetMcqs   Int       @default(100) @map("weekly_target_mcqs")
  /** Tier 1 marks you're aiming for, used for the score projection. */
  targetScore        Int       @default(150) @map("target_score")
  /** Planning cutoff band: ur | ews | obc | sc | st | custom. */
  cutoffCategory     String    @default("ur") @map("cutoff_category")
  /** Local time for the daily nudge, as "HH:mm". */
  reminderTime       String?   @map("reminder_time")
  /** Minutes offset from UTC, so the cron can resolve the user's local time. */
  reminderOffset     Int       @default(330) @map("reminder_offset")
  seenMilestones     String[]  @default([]) @map("seen_milestones")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("user_settings")
}

/** Web push endpoint for the daily reminder. */
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}

model MockTest {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  testDate           DateTime @map("test_date") @db.Date
  name               String
  totalQuestions     Int      @map("total_questions")
  correct            Int
  wrong              Int
  score              Float?
  percentile         Float?
  sectionalBreakdown Json?    @map("sectional_breakdown")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([testDate])
  @@map("mock_tests")
}

model ActivityDay {
  id     String   @id @default(uuid()) @db.Uuid
  userId String   @map("user_id") @db.Uuid
  date   DateTime @db.Date

  @@unique([userId, date])
  @@index([userId])
  @@map("activity_days")
}
